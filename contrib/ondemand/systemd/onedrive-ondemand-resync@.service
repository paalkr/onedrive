[Unit]
# The instance name is the profile (directory) name below ~/.config, also for the
# default profile: onedrive-ondemand-resync@onedrive-ondemand.service
Description=OneDrive Files On-Demand resync (profile %i)
Documentation=man:onedrive-ondemand-resync(1) file:///usr/share/doc/onedrive-ondemand/README.ondemand.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# No sandboxing options, for the same reasons as onedrive-ondemand.service:
# a private mount namespace hides the mount, NoNewPrivileges= breaks fusermount3.
# Marks the profile as resyncing (the normal unit refuses to start while the
# marker exists) and stops the profile's normal unit.
ExecStartPre=/usr/libexec/onedrive-ondemand/resync-unit pre %i
ExecStart=/usr/bin/onedrive --on-demand --on-demand-resync-once --confdir=%h/.config/%i
# Lazily unmounts sync_dir if the client left a stale mount behind (crash, kill)
ExecStopPost=/usr/bin/onedrive-ondemand-unmount --confdir=%h/.config/%i
# Removes the marker and, only if the resync succeeded, starts the normal unit again.
# On failure this unit is left in the failed state and the normal unit stays stopped.
ExecStopPost=/usr/libexec/onedrive-ondemand/resync-unit post %i
# A resync of a large drive can take a long time
TimeoutStartSec=infinity
TimeoutStopSec=90
